<Page x:Class="YFToolbox.Features.Images.Views.ImageConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core"
             AllowDrop="True"
             Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="{x:Static loc:AppStrings.Converter}" />

            <Border Grid.Row="1" Margin="0,20,0,20" Padding="28" Style="{StaticResource YFCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="18" Text="{x:Static loc:AppStrings.DropFilesHere}" />
                    <Button Margin="0,14,0,0" Padding="18,8" Click="OnChooseFiles" Content="{x:Static loc:AppStrings.ChooseFiles}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{x:Static loc:AppStrings.TargetFormat}" />
                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding TargetFormat}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static loc:AppStrings.Width}" />
                    <TextBox Margin="0,6,0,0" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static loc:AppStrings.Height}" />
                    <TextBox Margin="0,6,0,0" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="{x:Static loc:AppStrings.Quality}" />
                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding QualityPresets}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding QualityPreset}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding Items}" MinHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                        <TextBlock Opacity="0.7" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Text="{Binding Dimensions}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,2" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{Binding Input.FileName}" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding DisplayStatus}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Error.Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding LockAspectRatio}" Content="{x:Static loc:AppStrings.LockAspectRatio}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding AllowUpscale}" Content="{x:Static loc:AppStrings.AllowUpscale}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding PreserveMetadata}" Content="{x:Static loc:AppStrings.PreserveMetadata}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding FlipHorizontal}" Content="{x:Static loc:AppStrings.FlipHorizontal}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding FlipVertical}" Content="{x:Static loc:AppStrings.FlipVertical}" />
                    <CheckBox Margin="0,0,0,12" IsChecked="{Binding AllowLargeImage}" Content="{x:Static loc:AppStrings.ConfirmLargeImages}" />
                    <TextBlock Text="{x:Static loc:AppStrings.Rotation}" />
                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotation}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding TransparencyWarning}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding Status}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Padding="14,7" Command="{Binding ClearCommand}" Content="{x:Static loc:AppStrings.Clear}" />
                    <Button Margin="0,0,8,0" Padding="14,7" Command="{Binding CancelCommand}" Content="{x:Static loc:AppStrings.Cancel}" />
                    <Button Margin="0,0,8,0" Padding="14,7" Command="{Binding RetryFailedCommand}" Content="{x:Static loc:AppStrings.RetryFailed}" />
                    <Button Padding="18,7" Command="{Binding StartCommand}" Content="{x:Static loc:AppStrings.Start}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
