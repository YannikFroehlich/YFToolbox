<Page x:Class="YFToolbox.Features.Files.Views.FileUtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core"
             AllowDrop="True"
             Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="{x:Static loc:AppStrings.FileUtilities}" />
            <Border Grid.Row="1" Margin="0,20" Padding="22" Style="{StaticResource YFSubtleCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource YFCardTitleStyle}" Text="{Binding SelectedFile.FileName, TargetNullValue={x:Static loc:AppStrings.ChooseAFile}}" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.75" Text="{Binding SelectedFile.FullPath}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding SelectedFile.DisplaySize}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding SelectedFile.MimeType}" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding SelectedFile.FileName}" Content="{x:Static loc:AppStrings.CopyFileName}" />
                            <Button Padding="10,4" Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding SelectedFile.FullPath}" Content="{x:Static loc:AppStrings.CopyPath}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Padding="16,8" Click="OnChooseFile" Content="{x:Static loc:AppStrings.ChooseFiles}" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="2">
                <TextBlock FontWeight="SemiBold" Text="SHA-256" />
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox IsReadOnly="True" Text="{Binding Sha256}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5" Command="{Binding CopyCommand}" CommandParameter="{Binding Sha256}" Content="{x:Static loc:AppStrings.Copy}" />
                </Grid>
                <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.Md5Legacy}" />
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox IsReadOnly="True" Text="{Binding Md5}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5" Command="{Binding CopyCommand}" CommandParameter="{Binding Md5}" Content="{x:Static loc:AppStrings.Copy}" />
                </Grid>
                <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" />
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Status}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Padding="14,7" Command="{Binding CancelCommand}" Content="{x:Static loc:AppStrings.Cancel}" />
                    <Button Padding="18,7" Command="{Binding CalculateHashesCommand}" Content="{x:Static loc:AppStrings.CalculateHash}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
