<Page x:Class="YFToolbox.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core"
      AllowDrop="True"
      Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="34" FontWeight="SemiBold" Text="YF Toolbox" />
                <TextBlock Margin="0,6,0,0" FontSize="16" Opacity="0.72" Text="{x:Static loc:AppStrings.HomeSubtitle}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,24,0,24" Padding="36" BorderBrush="#70678BC7" BorderThickness="1"
                    CornerRadius="14" Background="#125B8DEF">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Text="{x:Static loc:AppStrings.DropFilesHere}" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Opacity="0.7" Text="{x:Static loc:AppStrings.FoldersNotProcessed}" />
                    <Button Margin="0,18,0,0" Padding="20,9" Click="OnChooseFiles" Content="{x:Static loc:AppStrings.ChooseFiles}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,0,0,12" FontSize="20" FontWeight="SemiBold" Text="{x:Static loc:AppStrings.QuickTools}" />
            <UniformGrid Grid.Row="3" Margin="0,0,0,24" Columns="3">
                <Button Margin="0,0,10,0" Padding="18" HorizontalContentAlignment="Left" Command="{Binding OpenConverterCommand}">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static loc:AppStrings.Converter}" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.72" Text="PNG · JPG · WebP · BMP · ICO" />
                    </StackPanel>
                </Button>
                <Button Margin="5,0" Padding="18" HorizontalContentAlignment="Left" Command="{Binding OpenRenameCommand}">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static loc:AppStrings.BatchRename}" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.72" Text="{x:Static loc:AppStrings.RenameQuickDescription}" />
                    </StackPanel>
                </Button>
                <Button Margin="10,0,0,0" Padding="18" HorizontalContentAlignment="Left" Command="{Binding OpenUtilitiesCommand}">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static loc:AppStrings.FileUtilities}" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.72" Text="{x:Static loc:AppStrings.UtilitiesQuickDescription}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static loc:AppStrings.RecentFiles}" />
                    <Button Grid.Column="1" Padding="12,5" Command="{Binding ClearCommand}" Content="{x:Static loc:AppStrings.Clear}" />
                </Grid>
                <ItemsControl Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14" BorderBrush="#405E7184" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding File.FileName}" />
                                        <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding File.FullPath}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#FFD67A" Text="{Binding Warning}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding File.DisplaySize}" />
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Opacity="0.75" Text="{Binding Actions}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Status}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
