<Page x:Class="YFToolbox.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core"
      ScrollViewer.CanContentScroll="False"
      AllowDrop="True"
      DragEnter="OnDragEnter"
      DragLeave="OnDragLeave"
      Drop="OnDrop">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="YF Toolbox" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Text="{x:Static loc:AppStrings.HomeSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Drop target -->
                <Grid MinHeight="168">
                    <Rectangle x:Name="DropOutline" Style="{StaticResource DropZoneOutline}" />
                    <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="28"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Symbol="DocumentMultiple24" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{x:Static loc:AppStrings.DropFilesHere}" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionText}"
                                   Text="{x:Static loc:AppStrings.FoldersNotProcessed}" />
                        <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Appearance="Primary"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Click="OnChooseFiles"
                                   Content="{x:Static loc:AppStrings.ChooseFiles}" />
                    </StackPanel>
                </Grid>

                <!-- Quick tools -->
                <TextBlock Margin="0,28,0,0" Style="{StaticResource SectionHeaderText}"
                           Text="{x:Static loc:AppStrings.QuickTools}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:CardAction Grid.Column="0" MinHeight="96" Icon="{ui:SymbolIcon Image24}" Command="{Binding OpenConverterCommand}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static loc:AppStrings.Converter}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="PNG · JPG · WebP · BMP · ICO" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Grid.Column="2" MinHeight="96" Icon="{ui:SymbolIcon Rename24}" Command="{Binding OpenRenameCommand}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static loc:AppStrings.BatchRename}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.RenameQuickDescription}" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Grid.Column="4" MinHeight="96" Icon="{ui:SymbolIcon DocumentToolbox24}" Command="{Binding OpenUtilitiesCommand}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static loc:AppStrings.FileUtilities}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.UtilitiesQuickDescription}" />
                        </StackPanel>
                    </ui:CardAction>
                </Grid>

                <!-- Detected files -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0" VerticalAlignment="Center" Style="{StaticResource SectionHeaderText}"
                               Text="{x:Static loc:AppStrings.RecentFiles}" />
                    <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Broom24}"
                               Command="{Binding ClearCommand}" Content="{x:Static loc:AppStrings.Clear}"
                               Visibility="{Binding Files, Converter={StaticResource CollectionToVisibility}, ConverterParameter=Invert}" />
                </Grid>

                <Border Margin="0,12,0,0" Padding="20,28" Style="{StaticResource CardSurface}"
                        Visibility="{Binding Files, Converter={StaticResource CollectionToVisibility}}">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}"
                               Text="{x:Static loc:AppStrings.NoFiles}" />
                </Border>

                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowSurface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding File.FileName}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding File.FullPath}" Text="{Binding File.FullPath}" />
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource WarningText}" Text="{Binding Warning}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding File.DisplaySize}" />
                                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionText}" Text="{Binding Actions}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1" Style="{StaticResource StatusText}" Text="{Binding Status}" />
            </Grid>
        </Border>
    </Grid>
</Page>
