<Page x:Class="YFToolbox.App.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="MetaLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">
                <Image Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"
                       Source="/Assets/YFToolboxIcon.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="YF Toolbox" />
                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="{x:Static loc:AppStrings.AboutDescription}" />
                </StackPanel>
            </StackPanel>

            <Border Margin="0,28,0,0" Style="{StaticResource CardSurface}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{x:Static loc:AppStrings.Version}" />
                        <TextBlock Style="{StaticResource MetaValue}" Text="{Binding Version}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{x:Static loc:AppStrings.Commit}" />
                        <TextBlock Style="{StaticResource MetaValue}" ToolTip="{Binding Commit}" Text="{Binding Commit}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{x:Static loc:AppStrings.Channel}" />
                        <TextBlock Style="{StaticResource MetaValue}" Text="{Binding Channel}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource MetaLabel}" Text="{x:Static loc:AppStrings.Build}" />
                        <TextBlock Style="{StaticResource MetaValue}" Text="{Binding BuildTime}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:InfoBar Margin="0,16,0,0" IsOpen="True" IsClosable="False" Severity="Informational"
                        Title="{x:Static loc:AppStrings.PrivacyNotice}"
                        Message="{x:Static loc:AppStrings.AboutNotice}" />
        </StackPanel>
    </ScrollViewer>
</Page>
