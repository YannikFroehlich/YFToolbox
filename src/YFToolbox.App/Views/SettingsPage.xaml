<Page x:Class="YFToolbox.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="{x:Static loc:AppStrings.Settings}" />
            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,10" Text="{x:Static loc:AppStrings.Theme}" />
                <ComboBox Grid.Column="1" Margin="0,6" ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                <TextBlock Grid.Row="1" Margin="0,10" Text="{x:Static loc:AppStrings.Language}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6" ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Language}" />
                <TextBlock Grid.Row="2" Margin="0,10" Text="{x:Static loc:AppStrings.OutputMode}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6" ItemsSource="{Binding OutputModes}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding OutputMode}" />
                <TextBlock Grid.Row="3" Margin="0,10" Text="{x:Static loc:AppStrings.OutputFolder}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Margin="0,10" Text="{x:Static loc:AppStrings.CollisionPolicy}" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,6" ItemsSource="{Binding CollisionPolicies}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding CollisionPolicy}" />
                <TextBlock Grid.Row="5" Margin="0,10" Text="{x:Static loc:AppStrings.ImageDefaults}" />
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,8">
                    <ComboBox Margin="0,0,0,8" ItemsSource="{Binding QualityPresets}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding ImageQualityPreset}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding PreserveMetadata}" Content="{x:Static loc:AppStrings.PreserveMetadata}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding AllowUpscale}" Content="{x:Static loc:AppStrings.AllowUpscale}" />
                    <CheckBox IsChecked="{Binding HistoryEnabled}" Content="{x:Static loc:AppStrings.PathlessHistory}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Status}" />
                <Button Grid.Column="1" Padding="18,8" Command="{Binding SaveCommand}" Content="{x:Static loc:AppStrings.Save}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
