<Page x:Class="YFToolbox.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:YFToolbox.Core.Localization;assembly=YFToolbox.Core"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="SettingHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleText}" Text="{x:Static loc:AppStrings.Settings}" />

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900">

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="{x:Static loc:AppStrings.Appearance}" />

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon PaintBrush24}">
                    <ui:CardControl.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.Theme}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.ThemeDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="220" ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon LocalLanguage24}">
                    <ui:CardControl.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.Language}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.LanguageDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="220" ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Language}" />
                </ui:CardControl>

                <!-- Output -->
                <TextBlock Margin="0,20,0,10" Style="{StaticResource SectionHeaderText}" Text="{x:Static loc:AppStrings.Output}" />

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon FolderArrowRight24}">
                    <ui:CardControl.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.OutputMode}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.OutputModeDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="220" ItemsSource="{Binding OutputModes}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding OutputMode}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Folder24}">
                    <ui:CardControl.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.OutputFolder}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.OutputFolderDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Width="300" VerticalAlignment="Center"
                                    Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Click="OnBrowseOutputFolder" Content="{x:Static loc:AppStrings.Browse}" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentCopy24}">
                    <ui:CardControl.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.CollisionPolicy}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.CollisionPolicyDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="220" ItemsSource="{Binding CollisionPolicies}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding CollisionPolicy}" />
                </ui:CardControl>

                <!-- Image defaults -->
                <TextBlock Margin="0,20,0,10" Style="{StaticResource SectionHeaderText}" Text="{x:Static loc:AppStrings.ImageDefaults}" />

                <ui:CardExpander Margin="0,0,0,8" IsExpanded="True" Icon="{ui:SymbolIcon Image24}">
                    <ui:CardExpander.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.ImageDefaults}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.ImageDefaultsDescription}" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelText}" Text="{x:Static loc:AppStrings.Quality}" />
                        <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding QualityPresets}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ImageQualityPreset}" />
                        <CheckBox Margin="0,14,0,0" IsChecked="{Binding PreserveMetadata}" Content="{x:Static loc:AppStrings.PreserveMetadata}" />
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding AllowUpscale}" Content="{x:Static loc:AppStrings.AllowUpscale}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Privacy -->
                <TextBlock Margin="0,20,0,10" Style="{StaticResource SectionHeaderText}" Text="{x:Static loc:AppStrings.Privacy}" />

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon History24}">
                    <ui:CardControl.Header>
                        <StackPanel Style="{StaticResource SettingHeader}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static loc:AppStrings.PathlessHistory}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{x:Static loc:AppStrings.PathlessHistoryDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding HistoryEnabled}" />
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Action bar -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,14,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource StatusText}"
                           TextWrapping="Wrap" Text="{Binding Status}" />
                <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                           Command="{Binding SaveCommand}" Content="{x:Static loc:AppStrings.Save}" />
            </Grid>
        </Border>
    </Grid>
</Page>
